<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Warnings-as-errors is kept for CI (which gates merges) but relaxed for local builds so
      `dotnet build` and scripts/rerun.* work while the ~750 style/analyzer warnings from the
      first compile are still being burned down. The deliberate per-rule escalations in
      .editorconfig (CA1305, CA1310, CA2016 — the ones that are real bug classes in a trading
      system) stay as errors everywhere.
    -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(CI)' != 'true'">false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CA1873 fires on the params array behind ANY log call that takes an argument, so it lands in
      every project that logs at all. It is the same trade-off the projects here already decline
      for CA1848, and it gets the same answer repo-wide: an IsEnabled guard around every
      LogInformation costs more in noise than the array costs at runtime, and nothing in this
      solution logs on the tick path. Declared once here rather than copied into six csproj files.
    -->
    <NoWarn>$(NoWarn);CS1591;CA1873</NoWarn>
    <!--
      NU1901-1904 are the NuGet vulnerability advisories. They fire on transitive pins the repo
      cannot currently move without a wider dependency bump; keep them visible as warnings
      rather than failing every local build.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      Reported by GET /api/version and shown in the web shell. Kept in step with
      apps/web/package.json; the git commit rides along as +sha in InformationalVersion.
    -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Every project in this repo is deterministic and source-linked. Trading systems get
    debugged from production stack traces; make that possible.
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
