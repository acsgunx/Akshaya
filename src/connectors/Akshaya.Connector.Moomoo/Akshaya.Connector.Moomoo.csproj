<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The moomoo (Futu OpenAPI) connector, reached through an OpenD gateway.

    It references the CONTRACT (Akshaya.Connectors.Abstractions) and the connector SDK
    (Akshaya.Connectors.Sdk) and nothing else — no vendor SDK and no protobuf runtime. OpenD accepts
    JSON bodies inside its binary frame, so the whole protocol is implemented here from the published
    .proto definitions. It must never reference any Akshaya.Modules.* assembly; enforced by
    tests/Akshaya.Architecture.Tests.
  -->

  <PropertyGroup>
    <RootNamespace>Akshaya.Connector.Moomoo</RootNamespace>
    <AssemblyName>Akshaya.Connector.Moomoo</AssemblyName>
    <!--
      CA1848: LoggerMessage source-gen delegates. Log calls here are on cold paths (a vendor error,
              a socket state change); the push path is guarded with IsEnabled where it logs at all.
      CA2007: ConfigureAwait(false) on `await using`; every ordinary await carries it.
      CA1711: "type name ends in Stream". MoomooStream is the feed facet the connector guide names.
    -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Akshaya.Connectors.Abstractions\Akshaya.Connectors.Abstractions.csproj" />
    <ProjectReference Include="..\..\Akshaya.Connectors.Sdk\Akshaya.Connectors.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akshaya.Connector.Moomoo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- See Akshaya.Connector.Zerodha.csproj for why the manifest is both loose and embedded. -->
    <None Update="connector.manifest.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="connector.manifest.json" LogicalName="connector.manifest.json" />
  </ItemGroup>

</Project>
