<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Longbridge OpenAPI connector.

    It references the CONTRACT (Akshaya.Connectors.Abstractions) and the connector SDK
    (Akshaya.Connectors.Sdk) and nothing else — no vendor SDK and no protobuf runtime. The quote and
    trade gateways speak protobuf inside a small binary frame, and the handful of messages this
    connector needs are encoded by hand from the published .proto files (LongbridgeProtobuf.cs). It
    must never reference any Akshaya.Modules.* assembly; enforced by tests/Akshaya.Architecture.Tests.
  -->

  <PropertyGroup>
    <RootNamespace>Akshaya.Connector.Longbridge</RootNamespace>
    <AssemblyName>Akshaya.Connector.Longbridge</AssemblyName>
    <!--
      CA1848: LoggerMessage source-gen delegates. Log calls here are on cold paths.
      CA2007: ConfigureAwait(false) on `await using`; every ordinary await carries it.
      CA1711: "type name ends in Stream". LongbridgeStream is the feed facet the connector guide names.
    -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Akshaya.Connectors.Abstractions\Akshaya.Connectors.Abstractions.csproj" />
    <ProjectReference Include="..\..\Akshaya.Connectors.Sdk\Akshaya.Connectors.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Akshaya.Connector.Longbridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- See Akshaya.Connector.Zerodha.csproj for why the manifest is both loose and embedded. -->
    <None Update="connector.manifest.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="connector.manifest.json" LogicalName="connector.manifest.json" />
  </ItemGroup>

</Project>
